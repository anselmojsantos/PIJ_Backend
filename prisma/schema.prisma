generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model login_user {
  id       Int     @id(map: "dashlogin_pkey") @default(autoincrement())
  name     String? @db.VarChar(100)
  email    String? @db.VarChar(100)
  password String? @db.VarChar(255)
}

model orders {
  id           Int      @id
  waiter       String   @db.VarChar(80)
  table_number String   @db.VarChar(20)
  order_items  Json     @db.Json
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  status       String   @default("---") @db.VarChar(20)
}

model product_categories {
  id       Int        @id
  name     String     @db.VarChar(80)
  products products[]
}

model products {
  id                 Int                @id
  name               String             @db.VarChar(100)
  price              Decimal            @db.Decimal(10, 2)
  productcategoryid  Int
  product_categories product_categories @relation(fields: [productcategoryid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model waiters {
  id   Int    @id
  name String @db.VarChar(100)
}

model tables {
  id           Int    @id(map: "_tables__pkey")
  table_number String @unique(map: "_tables__table_number_key") @db.VarChar(20)
  status       Int?
}
